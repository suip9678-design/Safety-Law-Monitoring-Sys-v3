<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.safetylaw.monitor.mapper.AppSettingMapper">

    <select id="findAll" resultType="com.safetylaw.monitor.domain.AppSetting">
        SELECT SETTING_KEY, SETTING_VALUE FROM APP_SETTINGS
    </select>

    <select id="findByKey" resultType="com.safetylaw.monitor.domain.AppSetting">
        SELECT SETTING_KEY, SETTING_VALUE FROM APP_SETTINGS WHERE SETTING_KEY = #{settingKey}
    </select>

    <!--
      MERGE 한 문장으로 합치지 않는다. MERGE 의 USING 절에 값을 직접 넘기면
      그 값의 자료형을 알 수 없다며 거부하는 DB 가 있어, 먼저 수정해 보고
      바뀐 행이 없을 때만 새로 넣는 방식이 환경을 타지 않는다.
    -->
    <update id="updateValue">
        UPDATE APP_SETTINGS SET SETTING_VALUE = #{settingValue} WHERE SETTING_KEY = #{settingKey}
    </update>

    <insert id="insertValue">
        INSERT INTO APP_SETTINGS (SETTING_KEY, SETTING_VALUE) VALUES (#{settingKey}, #{settingValue})
    </insert>

</mapper>
